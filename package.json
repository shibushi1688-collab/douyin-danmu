{
  "name": "douyin-danmu-app",
  "version": "1.0.0",
  "description": "抖音弹幕获取工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.shibushi.danmu",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/.cache/**/*"
    ],
    "asar": true,
    "compression": "store"
  },
  "keywords": [
    "electron",
    "douyin",
    "danmu"
  ],
  "author": "SHIBUSHI",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "protobufjs": "^7.6.0",
    "ws": "^8.20.1"
  }
}
